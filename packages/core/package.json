{
  "name": "@fluxory/core",
  "version": "0.1.0",
  "description": "Core types, trace IDs, and transport for Fluxory observability",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashishgautam02/fluxory-npm",
    "directory": "packages/core"
  },
  "keywords": ["observability", "tracing", "logging", "spans", "telemetry", "monitoring", "apm"],
  "engines": {
    "node": ">=18"
  }
}
