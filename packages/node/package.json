{
  "name": "@fluxory/node",
  "version": "0.1.0",
  "description": "Node.js auto-instrumentation for Fluxory observability",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@fluxory/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashishgautam02/fluxory-npm",
    "directory": "packages/node"
  },
  "keywords": ["observability", "tracing", "logging", "nodejs", "auto-instrumentation", "monitoring", "apm", "express", "postgresql", "redis"],
  "engines": {
    "node": ">=18"
  }
}
